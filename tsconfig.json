{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["client-entry.tsx", "src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
